# Nom d'hôte résolu sur le réseau local. Malgré son nom, IP_LINUX accepte un nom DNS.
IP_LINUX=serveur-nino-HP-Compaq-8200-Elite-SFF-PC

# Compte Linux existant utilisé pour la connexion SSH.
SSH_USER=serveur-nino

# Chemin local vers une clé privée Ed25519 dédiée. Remplacer cette valeur dans `.env`.
SSH_KEY=C:\Users\<utilisateur>\.ssh\id_ed25519_serveur_linux

# Port d'écoute du serveur OpenSSH.
SSH_PORT=22
